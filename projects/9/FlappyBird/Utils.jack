/**
 * Utility class.
 */
class Utils {
    /** Returns true if 2 bounds, a and b, are intersecting
     *  where:
     *  x = x position
     *  y = y position
     *  w = width
     *  h = height
     */
    function boolean areBoundsIntersecting(
        int ax, int ay, int aw, int ah,
        int bx, int by, int bw, int bh
    ) {
        if (((ax + aw) < bx) | ((ax + aw) = bx)) {
            return false;
        }

        if (((bx + bw) < ax) | ((bx + bw) = ax)) {
            return false;
        }

        if (((ay + ah) < by) | ((ay + ah) = by)) {
            return false;
        }

        if (((by + bh) < ay) | ((by + bh) = ay)) {
            return false;
        }

        return true;
    }

    /** returns a % b */
    function int mod(int a, int b) {
        var int d;
        var int r;
        let d = Math.divide(a,b);
        let r = a - (b * d);
        return r;
    }

