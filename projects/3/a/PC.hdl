// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Not(in=reset, out=nReset);
    And(a=nReset, b=load, out=isLoad);
    Or(a=reset, b=isLoad, out=orResetLoad);
    Not(in=orResetLoad, out=nResetLoad);
    Not(in=load, out=nLoad);
    Not(in=inc, out=nInc);
    And(a=nLoad, b=nInc, out=nLoadInc);
    And(a=nReset, b=nLoadInc, out=isElse);
    Or(a=isLoad, b=isElse, out=loadOrElse);

    Mux4Way16(
        a=false, b=in, c=elsePlus1, d=elseInput, 
        sel[0]=loadOrElse, sel[1]=nResetLoad,
        out=muxOut);

    Register(in=muxOut, load=true, 
        out=out, out=elseInput);
    Inc16(in=elseInput, out=elsePlus1);
}
